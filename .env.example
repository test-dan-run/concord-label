# Copy to .env. Every setting has a default; see backend/concord_label/core/settings.py.
# CONCORD_DATA=./data                 # audio, derived files and concord.db (local disk)
# CONCORD_PORT=8620                   # API port (`just dev`, `just api`); Concord Bench uses 8600
# CONCORD_WEB_PORT=5174               # Vite dev server port (`just dev`); Bench uses 5173
# PLATFORM_DIR=../../platform         # platform repo: the aicore endpoint map
# CATALOG_URL=http://127.0.0.1:8700   # the model catalog (or AICORE_CATALOG); http://catalog:8700 in a container
# CATALOG_UI_URL=                     # where people open the catalog's pages (default: CATALOG_URL)
# PUBLIC_URL=http://127.0.0.1:8620    # where the catalog and Bench reach this API (http://concord-label:8620 on ai-net)
# AICORE_ENDPOINTS=                   # a copy of endpoints.generated.yaml, if not the platform's
# AI_HOST=localhost                   # `{name}` when Concord runs in a container on ai-net
# BENCH_URL=http://localhost:8600     # Concord Bench: Send to Bench pushes there, live eval shows its scores
# DATASET_STORE=                     # the Dataset Catalog's store, mounted read-only (e.g. ~/ai-data/datasets): set,
#                                    # new audio goes there through CATALOG_URL, and datasets publish to the catalog
# REPLAY_DIR=fixtures/recorded        # serve recorded model responses (demo / tests without a GPU)
# RECORD_DIR=                         # write every live response here
